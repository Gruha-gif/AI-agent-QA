{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "qa-orchestrator",
  "instructions": ["AGENTS.md"],
  "skills": {
    "paths": [".opencode/skills"]
  },
  "mcp": {
    "qa-mock": {
      "type": "local",
      "command": ["python", "scripts/mock_qa_mcp.py"],
      "enabled": true,
      "environment": {
        "QA_ARTIFACTS_DIR": "artifacts"
      }
    },
    "jsd": { "enabled": false },
    "playwright": { "enabled": false },
    "chrome-devtools": { "enabled": false },
    "sentry": { "enabled": false }
  },
  "permission": {
    "edit": "allow",
    "read": "allow",
    "task": "allow",
    "bash": {
      "*": "ask",
      "*validate_artifacts.py*": "allow",
      "*check_json.py*": "allow",
      "python scripts/mock_qa_mcp.py": "allow"
    }
  }
}
